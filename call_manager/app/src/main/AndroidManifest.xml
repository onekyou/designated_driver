<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 인터넷 권한 (Firebase 등 네트워크 통신에 필요) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ⭐️ 알림 관련 추가 권한 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- 화면 위에 그리기 권한 (다른 앱 위에 표시) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service 및 백그라운드 작업 권한 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />



    <!-- 전화 감지 권한 (콜 디텍터 기능) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 음성 인식 권한 (음성 입력 기능) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- PTT 오디오 라우팅 (Agora) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 배터리 최적화 예외 요청 권한 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    

    <application
        android:name=".CallManagerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules" 
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher" 
        android:label="@string/app_name" 
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallManager" 
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CallManager"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.designated.callmanager.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.designated.callmanager.ACTION_SHOW_CALL_DIALOG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- ⭐️ 새로운 FCM 액션을 위한 인텐트 필터 추가 -->
            <intent-filter>
                <action android:name="ACTION_SHOW_CALL_POPUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- ⭐️ 공유콜 FCM 액션을 위한 인텐트 필터 추가 -->
            <intent-filter>
                <action android:name="ACTION_SHOW_SHARED_CALL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 카톡/문자 등에서 텍스트 공유 받기 → 사무실 단톡방 입력 prefill -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 백그라운드 서비스 등록 -->
        <service
            android:name=".service.CallManagerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="실시간 콜 데이터 수신 및 관리 서비스" />
        </service>


        <!-- FCM 메시징 서비스 등록 -->
        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 부팅 시 자동 시작을 위한 BroadcastReceiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        
        <!-- Call Detector 상태 수신 BroadcastReceiver -->
        <!-- exported=false: 커스텀 액션이므로 외부 앱에서 접근할 필요 없음 -->
        <receiver
            android:name=".receiver.CallDetectorStatusReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.designated.CALL_DETECTOR_STATUS" />
            </intent-filter>
        </receiver>
        
        <!-- SharedCall 알림 수락/취소 BroadcastReceiver -->
        <receiver
            android:name=".service.SharedCallNotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ACTION_ACCEPT_SHARED_CALL" />
                <action android:name="ACTION_CANCEL_SHARED_CALL" />
            </intent-filter>
        </receiver>
        
        <!-- 전화 상태 감지 BroadcastReceiver (콜 디텍터 기능) -->
        <receiver
            android:name=".receiver.CallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>
        
        <!-- 콜 디텍터 서비스 -->
        <service
            android:name=".service.CallDetectorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="전화 감지 및 콜 생성 서비스" />
        </service>




        <!-- Android 15 호환성 -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
            
        <!-- 
        Firebase 초기화를 위한 메타데이터 (Firebase 문서 참고 필요)
        <meta-data
            android:name="com.google.firebase.components:com.google.firebase.auth.FirebaseAuthRegistrar"
            android:value="com.google.firebase.components.ComponentRegistrar" />
        <meta-data
            android:name="com.google.firebase.components:com.google.firebase.firestore.FirestoreRegistrar"
            android:value="com.google.firebase.components.ComponentRegistrar" /> 
        -->

        <activity
        android:name=".ui.popup.RequestOverlayPermissionActivity"
        android:exported="false" />

        <!-- 공유콜 중간팝업 Activity -->
        <activity
            android:name=".ui.SharedCallAcceptActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CallManager" />

        <!-- FileProvider for QR code sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

</application>

</manifest> 