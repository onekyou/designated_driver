rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper functions (admins 컬렉션 기준) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHeadManager() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['HEAD_MANAGER', 'SUPER_ADMIN'];
    }

    function isOfficeOwner() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'OFFICE_OWNER';
    }

    // --- APK 릴리즈 파일 ---
    //  • 업로드(쓰기): 총관리자(HEAD_MANAGER/SUPER_ADMIN)만
    //  • 다운로드(읽기): 총관리자 + 사장님(OFFICE_OWNER)
    //  • 200MB 제한 + APK 확장자 강제
    match /apks/{appName}/{fileName} {
      allow read: if isHeadManager() || isOfficeOwner();
      allow write: if isHeadManager()
        && request.resource.size < 200 * 1024 * 1024
        && fileName.matches('.*\\.apk');
    }

    // --- Chat 이미지 (사무실 단톡방) ---
    //  • 인증된 사용자 + 2MB + image/* (cross-service firestore.exists는 wildcard substitution 작동 X)
    //  • 보안 분석:
    //    - read URL: firestore.rules에서 chat 메시지를 멤버만 read → imageUrl은 사실상 멤버에게만 노출
    //    - write: 비멤버가 storage 업로드해도 firestore.rules가 chat 메시지 create 거부 → orphan 파일만
    //  • Phase 2: weekly orphan-scan CF로 firestore에 매핑 안 된 storage 파일 정리
    //  • update/delete 금지 (CF scheduledChatMessageCleanup만 처리)
    match /provinces/{provinceId}/cities/{cityId}/offices/{officeId}/chat_images/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // --- Chat 음성 메모 (PTT 콜드 발화 → 음성 첨부, 사무실 단톡방) ---
    //  • 인증된 사용자 + 1MB + audio/* (chat_images와 동일 보안 모델)
    //  • 클라가 putBytes 시 StorageMetadata contentType="audio/mp4" 명시 → 룰 통과
    //  • update/delete 금지 (CF scheduledChatMessageCleanup만 audioPath 처리)
    match /provinces/{provinceId}/cities/{cityId}/offices/{officeId}/chat_audio/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow update, delete: if false;
    }
  }
}
