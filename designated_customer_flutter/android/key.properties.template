# Android Release 서명 설정
#
# 이 파일을 "key.properties"로 복사하고 실제 값을 입력하세요
# key.properties는 .gitignore에 추가되어야 합니다 (보안)
#
# keystore 파일 생성 방법:
# keytool -genkey -v -keystore customer-app-release.keystore -alias customer-app -keyalg RSA -keysize 2048 -validity 10000

storeFile=C:/app_dev/designated_driver/releases/customer-app-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=customer-app
keyPassword=YOUR_KEY_PASSWORD_HERE
