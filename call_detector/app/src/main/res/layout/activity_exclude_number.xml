<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF121212"
        android:orientation="vertical">

        <!-- 상단 액션 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF2A2A2A"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. 전화번호부에서 선택 (대형 노란 버튼) -->
            <Button
                android:id="@+id/contactsButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="전화번호부에서 선택"
                android:textColor="#FF000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFAB00" />

            <!-- 2. 등록된 번호 검색 토글 버튼 -->
            <Button
                android:id="@+id/searchToggleButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🔍  등록된 번호 검색  ▼"
                android:textColor="#FFCCCCCC"
                android:textSize="14sp"
                android:textAllCaps="false" />

            <!-- 3. 검색바 (초기에는 GONE, 토글로 표시) -->
            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:background="@drawable/search_background"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableTint="#FFFFFFFF"
                android:drawablePadding="12dp"
                android:hint="이름 또는 번호로 검색"
                android:textColorHint="#FF999999"
                android:textColor="#FFFFFFFF"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="12dp" />

            <!-- 4. 카운트 -->
            <TextView
                android:id="@+id/countTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="총 0개의 개인번호"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- 리스트 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

    </LinearLayout>

    <!-- FAB 추가 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/purple_500" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>