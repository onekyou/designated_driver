rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks if the currently authenticated user's UID matches the provided userId
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Checks if the currently authenticated user is an admin of the specified office
    function isOfficeAdmin(provinceId, cityId, officeId) {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.uid);
      return isAuthenticated()
             && exists(adminPath)
             && get(adminPath).data.associatedProvinceId == provinceId
             && get(adminPath).data.associatedCityId == cityId
             && get(adminPath).data.associatedOfficeId == officeId;
    }
    
    // Checks if the currently authenticated user is an admin (any office)
    function isAnyAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Checks if the currently authenticated user is a HEAD_MANAGER or SUPER_ADMIN
    function isHeadManager() {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.uid);
      return isAuthenticated()
             && exists(adminPath)
             && get(adminPath).data.role in ['HEAD_MANAGER', 'SUPER_ADMIN'];
    }

    // Checks if the currently authenticated user is an OFFICE_OWNER
    function isOfficeOwner() {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.uid);
      return isAuthenticated()
             && exists(adminPath)
             && get(adminPath).data.role == 'OFFICE_OWNER';
    }

    // --- Top-Level Collections ---

    // 🔥 회원가입 시 도/광역시 목록 조회를 위한 provinces 컬렉션 읽기 허용
    match /provinces/{provinceId} {
      // 도/광역시 정보는 회원가입 시 필요하므로 모든 사용자에게 읽기 허용
      allow read: if true;

      // 도/광역시 생성/수정/삭제는 서버(Cloud Functions)만 허용
      allow write: if request.auth == null;

      // 🔥 회원가입 시 시/군/구 목록 조회를 위한 cities 컬렉션 읽기 허용
      match /cities/{cityId} {
        // 시/군/구 정보는 회원가입 시 필요하므로 모든 사용자에게 읽기 허용
        allow read: if true;

        // 시/군/구 생성/수정/삭제는 서버(Cloud Functions)만 허용
        allow write: if request.auth == null;
      }
    }

    match /admins/{adminId} { // adminId is the document ID, should be user's UID
      // 본인의 admin 문서는 읽기/쓰기 가능
      allow read, write: if isOwner(adminId);
      // 🔥 Firebase Functions가 FCM 토큰 조회를 위해 읽기 접근 허용
      allow read: if request.auth == null; // Firebase Functions (서버 사이드)
      // 🔥 총관리자 웹: 인증된 사용자는 자신의 admin 문서 읽기 허용
      allow read: if isAuthenticated() && request.auth.uid == adminId;
    }

    match /pending_drivers/{userId} { // userId is the document ID, should be user's UID
      allow create: if isOwner(userId);
      allow read: if isAnyAdmin() || isOwner(userId);
      allow delete: if isAnyAdmin();
    }

    // --- Collection Group for Drivers to find their own document ---
    // ★★★ 중요 수정: 기사가 로그인 후 자신의 정보를 가져올 수 있도록 수정 ★★★
    // DriverViewModel이 이 규칙을 사용하여 authUid로 기사 문서를 찾습니다.
    // ★★★ 임시 디버깅용 - 로그인된 사용자는 모든 기사 문서 읽기 허용 ★★★
    match /{path=**}/designated_drivers/{docId} {
      allow read: if isAuthenticated();
    }

    // ★★★ 픽업 기사 collectionGroup 쿼리 지원 ★★★
    match /{path=**}/pickup_drivers/{docId} {
      allow read: if isAuthenticated() && resource.data.authUid == request.auth.uid;
    }

    // ★★★ 총관리자 웹: offices collectionGroup 쿼리 지원 ★★★
    // 총관리자가 모든 region의 offices를 조회할 수 있도록 허용
    match /{path=**}/offices/{officeId} {
      allow read: if isHeadManager() || isAuthenticated();
    }

    // ★★★ 총관리자 웹: withdrawalRequests collectionGroup 쿼리 지원 ★★★
    // 총관리자가 모든 region의 withdrawalRequests를 조회할 수 있도록 허용
    match /{path=**}/withdrawalRequests/{requestId} {
      allow read: if isHeadManager();
    }

    // --- Nested Collections under Provinces/Cities/Offices ---
    match /provinces/{provinceId}/cities/{cityId}/offices/{officeId} {
      // 🔥 회원가입 시 사무실 목록 조회를 위해 모든 사용자에게 읽기 허용
      allow read: if true; // Allow basic office info reading for signup

      // 사무실 상태(status) 필드 업데이트 허용 - 관리자만
      allow update: if isOfficeAdmin(provinceId, cityId, officeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // 사무실 기본 정보 생성/업데이트 허용 (status 필드 포함)
      allow write: if isOfficeAdmin(provinceId, cityId, officeId);

      // 🔥 회원가입 시 새로운 사무실 생성 허용 - 인증된 사용자면 새 사무실 생성 가능
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid;

      match /designated_drivers/{driverDocId} {
        // 읽기(read): 관리자이거나, 기사 본인인 경우 허용
        allow read: if isOfficeAdmin(provinceId, cityId, officeId) || (isAuthenticated() && resource.data.authUid == request.auth.uid);

        // 쓰기(write): 관리자이거나, 기사 본인인 경우 허용
        allow write: if isOfficeAdmin(provinceId, cityId, officeId) || (isAuthenticated() && resource.data.authUid == request.auth.uid);
      }

      match /calls/{callId} {
        // 해당 사무실의 관리자 또는 배정된 기사(assignedDriverId 필드로 확인)는 특정 콜 정보를 가져오거나 쿼리할 수 있습니다.
        // get과 list 규칙을 read로 통합하여 권한 충돌 문제를 해결합니다.
        allow read: if
            isOfficeAdmin(provinceId, cityId, officeId) ||
            (isAuthenticated() && resource.data.assignedDriverId == request.auth.uid) ||
            isAuthenticated(); // ★★★ 임시 디버깅용 - 로그인된 사용자는 모든 콜 읽기 허용 ★★★

        // 콜 생성: 누구나 콜을 생성할 수 있습니다 (콜 디텍터 앱용).
        allow create: if true;

        // 콜 삭제: 사무실 관리자 또는 공유콜을 취소하는 기사가 가능합니다.
        allow delete: if
          isOfficeAdmin(provinceId, cityId, officeId) ||
          // 기사가 자신에게 배정된 공유콜을 취소(삭제)하는 경우
          (isAuthenticated() &&
           resource.data.assignedDriverId == request.auth.uid &&
           resource.data.callType == "SHARED");

        // 콜 업데이트 (상태 머신):
        // 관리자, 배정된 기사, 또는 고객 본인이 업데이트 가능
        allow update: if
          isOfficeAdmin(provinceId, cityId, officeId) ||
          // 고객이 자신의 콜을 취소하는 경우 (WAITING/ASSIGNED/RESERVED/ACCEPTED/PREPARING)
          (isAuthenticated() &&
           (resource.data.status == "WAITING" || resource.data.status == "REQUESTED" ||
            resource.data.status == "ASSIGNED" || resource.data.status == "RESERVED" ||
            resource.data.status == "ACCEPTED" || resource.data.status == "PREPARING") &&
           request.resource.data.status == "CANCELLED_BY_CUSTOMER") ||
          (
            // 업데이트 요청자가 해당 콜에 배정된 기사인지 확인
            isAuthenticated() && resource.data.assignedDriverId == request.auth.uid &&
            (
              // 상태 전환 규칙 (필요시 각 상태별 필드 변경 규칙 추가)
              (resource.data.status == "ASSIGNED" && request.resource.data.status == "ACCEPTED") ||
              // 기사가 콜을 거절할 때: ASSIGNED → WAITING 허용 (rejectCall)
              (resource.data.status == "ASSIGNED" && request.resource.data.status == "WAITING") ||
              // 기사가 예약 콜을 수락: RESERVED → ACCEPTED (운행 종료 후 [수락])
              (resource.data.status == "RESERVED" && request.resource.data.status == "ACCEPTED") ||
              // 기사가 예약 콜을 거절: RESERVED → WAITING (매니저 재배차 가능)
              (resource.data.status == "RESERVED" && request.resource.data.status == "WAITING") ||
              (resource.data.status == "ACCEPTED" && request.resource.data.status == "IN_PROGRESS") ||
              (resource.data.status == "IN_PROGRESS" && request.resource.data.status == "AWAITING_SETTLEMENT") ||
              (resource.data.status == "AWAITING_SETTLEMENT" && request.resource.data.status == "COMPLETED") ||
              // 기사가 운행 취소할 때: ACCEPTED/PREPARING/IN_PROGRESS → CANCELLED_BY_DRIVER 허용
              ((resource.data.status == "ACCEPTED" || resource.data.status == "PREPARING" || resource.data.status == "IN_PROGRESS") &&
               request.resource.data.status == "CANCELLED_BY_DRIVER") ||
              // 기사가 공유콜을 취소할 때: ASSIGNED/ACCEPTED → CANCELLED_BY_DRIVER 허용
              ((resource.data.status == "ASSIGNED" || resource.data.status == "ACCEPTED") &&
               request.resource.data.status == "CANCELLED_BY_DRIVER" &&
               resource.data.callType == "SHARED")
            )
          ) ||
          // ✅ 기사 본인 COMPLETED 콜 결제수단 정정 (commit 4 #3, 정산 재설계 §5.2 자기 정정)
          // status·fare·completedAt 불변 보장, 결제 관련 필드만 화이트리스트로 허용
          (isAuthenticated() &&
           resource.data.assignedDriverId == request.auth.uid &&
           resource.data.status == "COMPLETED" &&
           request.resource.data.status == "COMPLETED" &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paymentMethod', 'cashReceived', 'creditAmount', 'finalFare'])) ||
          // 공유콜 취소 시 원본 사무실 콜을 원래 상태로 복구 허용
          // 기사가 공유콜을 취소할 때 원본 사무실의 콜을 복구할 수 있도록 허용
          (isAuthenticated() &&
           resource.data.callType == "SHARED" &&
           request.resource.data.status == "SHARED" &&
           request.resource.data.status == "WAITING" &&
           request.resource.data.cancelReason != null);
      }

      // ✅ 포인트(balance) 문서 규칙 – 사무실 관리자 읽기/쓰기 가능, 서버(Functions)도 허용
      match /points/{pointsId} {
        allow read: if isOfficeAdmin(provinceId, cityId, officeId) || isAuthenticated();
        // Cloud Functions(서버 사이드) 또는 관리자가 잔액/충전 변경 허용
        allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);
      }

      // ✅ 사무실별 포인트 거래 내역 규칙
      match /point_transactions/{transactionId} {
        // 해당 사무실 관리자 또는 인증된 사용자가 거래 내역 조회 가능
        allow read: if isOfficeAdmin(provinceId, cityId, officeId) || isAuthenticated();
        // Cloud Functions(서버) 또는 관리자만 생성/수정 가능 (테스트용)
        allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);
      }

      // =============================
      //  픽업 기사 컬렉션 (pickup_drivers)
      //  • 관리자와 본인 읽기/쓰기 허용
      //  • collectionGroup 쿼리 지원
      // =============================
      match /pickup_drivers/{driverDocId} {
        // 읽기(read): 관리자이거나, 기사 본인인 경우 허용
        allow read: if isOfficeAdmin(provinceId, cityId, officeId) || (isAuthenticated() && resource.data.authUid == request.auth.uid);

        // 쓰기(write): 관리자이거나, 기사 본인인 경우 허용
        allow write: if isOfficeAdmin(provinceId, cityId, officeId) || (isAuthenticated() && resource.data.authUid == request.auth.uid);
      }

      // =============================
      //  일일 정산(dailySettlements) & 세션 문서
      //  • 관리자 읽기 허용
      //  • Cloud Functions(서버) 또는 관리자만 쓰기 허용
      // =============================
      match /dailySettlements/{dateId} {
        allow read:  if isOfficeAdmin(provinceId, cityId, officeId);
        allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);

        // 서브컬렉션: sessions
        match /sessions/{sessionId} {
          allow read:  if isOfficeAdmin(provinceId, cityId, officeId);
          allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);
        }
      }

      // =============================
      //  Attribution 시스템 (콜매니저 계획서에 따름)
      //  • 랜딩페이지에서 생성 허용 (인증 없이)
      //  • Cloud Functions에서 읽기 허용
      //  • 관리자 읽기 허용 (수정/삭제 불가 - 무결성 보장)
      //  • 고객앱(익명 인증)에서도 읽기 허용 (사무실 매칭용)
      // =============================
      match /attributions/{attributionId} {
        // 랜딩페이지에서 익명으로 생성 허용
        allow create: if true;
        // 모두 읽기 허용 (랜딩페이지, 고객앱, 관리자, Cloud Functions)
        allow read: if true;
        // 수정/삭제 불가 (무결성 보장)
        allow update, delete: if false;
      }

      // =============================
      //  Customer 관리 (익명 인증 + 프로필 입력 방식)
      // =============================
      match /customers/{customerId} {
        // 관리자는 모든 고객 정보 읽기/쓰기 가능
        allow read, write: if isOfficeAdmin(provinceId, cityId, officeId);

        // 고객 본인은 자신의 데이터만 읽기 가능 (customerId = userId)
        allow read: if isAuthenticated() && request.auth.uid == customerId;

        // 익명 인증된 사용자는 자신의 프로필 생성 가능 (최초 1회)
        allow create: if isAuthenticated() &&
                        request.auth.uid == customerId &&
                        request.resource.data.id == customerId;

        // 고객 본인은 자신의 프로필 수정 가능
        allow update: if isAuthenticated() && request.auth.uid == customerId;
      }

      // =============================
      //  Customer Points (고객 포인트 시스템)
      // =============================
      match /customerPoints/{phoneNumber} {
        // 고객 본인 또는 관리자 읽기 가능
        allow read: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId);
        // 고객 본인 또는 관리자 또는 서버(Functions) 쓰기 가능
        allow write: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId) || request.auth == null;
      }

      // =============================
      //  Point Transactions (콜매니저 계획서에 따름)
      // =============================
      match /pointTransactions/{transactionId} {
        // 관리자 또는 인증된 사용자 읽기 가능
        allow read: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId);
        // 관리자, 인증된 사용자, 서버(Functions) 생성 가능
        allow create: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId) || request.auth == null;
        // 수정/삭제 불가 (이력 보존)
        allow update, delete: if false;
      }

      // =============================
      //  Settings (콜매니저 계획서에 따름)
      // =============================
      match /settings/{settingId} {
        allow read, write: if isOfficeAdmin(provinceId, cityId, officeId);
      }

      // =============================
      //  Customer Info (FCM 토큰 저장용)
      //  • 고객앱에서 FCM 토큰 저장
      //  • Functions에서 FCM 토큰 조회
      // =============================
      match /customerInfo/{phoneNumber} {
        // 관리자, 인증된 사용자, Functions 읽기 가능
        allow read: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId) || request.auth == null;
        // 인증된 사용자(고객앱), 관리자, Functions 쓰기 가능
        allow write: if isAuthenticated() || isOfficeAdmin(provinceId, cityId, officeId) || request.auth == null;
      }

      // =============================
      //  Manager Tokens (콜매니저 FCM 토큰 저장용)
      //  • 콜매니저 앱에서 로그인 시 FCM 토큰 저장
      //  • Functions에서 신규 회원 가입 알림 시 토큰 조회
      // =============================
      match /managerTokens/{adminId} {
        // 관리자 본인은 자신의 FCM 토큰 문서 쓰기 가능
        allow write: if isAuthenticated() && request.auth.uid == adminId;
        // Cloud Functions(서버)와 관리자는 읽기 가능
        allow read: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId) || (isAuthenticated() && request.auth.uid == adminId);
      }
      
      // =============================
      //  Banner Ads (배너 광고)
      //  • 모든 사용자가 읽기 가능 (광고 콘텐츠)
      //  • 관리자와 Functions만 쓰기 가능
      // =============================
      match /bannerAds/{bannerId} {
        // 광고는 모든 사용자에게 공개
        allow read: if true;
        // 관리자 또는 Cloud Functions(서버)만 쓰기 가능
        allow write: if isOfficeAdmin(provinceId, cityId, officeId) || request.auth == null;
      }

      // =============================
      //  Settlement Sessions (정산 세션)
      //  • 관리자 및 인증된 사용자 읽기 가능
      //  • Cloud Functions(서버) 또는 관리자만 쓰기 가능
      // =============================
      match /settlementSessions/{sessionDate} {
        allow read: if isOfficeAdmin(provinceId, cityId, officeId) || isAuthenticated();
        allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);
      }

      // =============================
      //  Chat Room (사무실 단톡방, V1)
      //  • 멤버 화이트리스트 방식 — chatRoom/main/members/{authUid} 문서 존재만 검사
      //  • 멤버 문서 자체 write는 전부 봉쇄 (CF만 admin 권한으로 set/delete)
      //  • 메시지 create는 멤버 본인만, update/delete 금지
      //  • 관련 스펙: docs/chat-shared-spec.md, 플랜: chat_feature_plan_2026-04-28.md
      // =============================
      match /chatRoom/{roomId} {
        function isChatMember() {
          return isAuthenticated()
            && exists(/databases/$(database)/documents/provinces/$(provinceId)/cities/$(cityId)/offices/$(officeId)/chatRoom/main/members/$(request.auth.uid));
        }

        // 룸 메타 자체는 멤버 read만, write는 CF (request.auth == null) 또는 매니저
        allow read: if isChatMember();
        allow write: if request.auth == null || isOfficeAdmin(provinceId, cityId, officeId);

        match /messages/{messageId} {
          allow read: if isChatMember();
          // 본인 senderId 메시지만 생성. text(1~2000자) / image(URL+path) / audio(URL+path) 중 하나 필수.
          allow create: if isChatMember()
                        && request.resource.data.senderId == request.auth.uid
                        && (
                             (request.resource.data.text is string
                               && request.resource.data.text.size() >= 1
                               && request.resource.data.text.size() <= 2000)
                             || (request.resource.data.imageUrl is string
                                 && request.resource.data.imageUrl.size() >= 1
                                 && request.resource.data.imageUrl.size() <= 1000
                                 && request.resource.data.imagePath is string
                                 && request.resource.data.imagePath.size() >= 1
                                 && request.resource.data.imagePath.size() <= 500)
                             || (request.resource.data.audioUrl is string
                                 && request.resource.data.audioUrl.size() >= 1
                                 && request.resource.data.audioUrl.size() <= 1000
                                 && request.resource.data.audioPath is string
                                 && request.resource.data.audioPath.size() >= 1
                                 && request.resource.data.audioPath.size() <= 500)
                           )
                        // 9-B: 클라가 시스템 메시지(type/senderRole=SYSTEM) 위조 차단. CF(Admin SDK)는 rules 우회.
                        && request.resource.data.get('type', '') != 'system'
                        && request.resource.data.get('senderRole', '') != 'SYSTEM';
          // V1: 메시지 수정/삭제 금지 (V2 검토)
          allow update, delete: if false;
        }

        match /members/{userId} {
          allow read: if isChatMember();
          // 클라이언트 write 전부 봉쇄. CF만 admin 권한으로 가입/탈퇴 시 set/delete (request.auth == null).
          allow write: if request.auth == null;
        }
      }

      // =============================
      //  Restaurants (식당, P0 식당앱)
      //  • 식당 doc은 callable CF가 admin SDK로 생성/관리 (redeemRestaurantInviteCode)
      //  • 식당 본인(익명 인증, ownerUid 매칭)은 자기 doc 읽기 + FCM 토큰 갱신
      //  • 사무실 매니저는 자기 사무실 식당 read
      //  관련 plan: abundant-floating-island.md §3.5
      // =============================
      match /restaurants/{restaurantId} {
        // 식당 본인 또는 사무실 매니저 read
        allow read: if isOfficeAdmin(provinceId, cityId, officeId)
                    || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
        // 식당 본인은 FCM 토큰 등 본인 필드만 update (ownerUid 변경 불가)
        allow update: if (isAuthenticated() && resource.data.ownerUid == request.auth.uid
                          && request.resource.data.ownerUid == resource.data.ownerUid)
                      || isOfficeAdmin(provinceId, cityId, officeId)
                      || request.auth == null;
        // create/delete는 CF만 (admin SDK)
        allow create, delete: if request.auth == null;
      }

      // =============================
      //  Restaurant Invite Codes (식당 가입 코드)
      //  • P0: 사용자(admin)만 generateRestaurantInviteCode 호출 → CF가 admin SDK로 생성
      //  • redeemRestaurantInviteCode (callable, 식당앱) → CF가 검증 + used = true
      //  • 클라이언트 직접 read/write 불가
      // =============================
      match /restaurantInviteCodes/{code} {
        allow read, write: if request.auth == null;
      }
    }

    // 공유 콜 규칙 – 관리자만 접근 가능, 기사는 내부콜만 처리
    match /shared_calls/{sharedCallId} {
      // 관리자만 조회 가능
      allow read: if isAnyAdmin();

      // 공유 콜 생성: 관리자만 가능 (source 사무실)
      allow create: if isAnyAdmin();

      /*
       * 공유 콜 상태 전환 허용:
       * 1) OPEN → CLAIMED: 관리자가 콜 수락
       * 2) CLAIMED → COMPLETED: Cloud Functions가 운행 완료 시 처리
       * 3) CLAIMED → OPEN: Cloud Functions가 기사 취소 시 처리
       */
      allow update: if
        // OPEN → CLAIMED (관리자가 수락)
        (isAnyAdmin() &&
         resource.data.status == "OPEN" &&
         request.resource.data.status == "CLAIMED") ||
        // Cloud Functions가 상태 변경 처리
        (request.auth == null);

      // 클라이언트 측 삭제 금지 - 서버만 가능
      allow delete: if request.auth == null;
    }

    // 포인트 거래 내역 컬렉션
    match /point_transactions/{transactionId} {
      // 관리자만 포인트 거래 내역 조회 가능
      allow read: if isAnyAdmin();
      // Cloud Functions(서버)만 생성/수정 가능
      allow write: if request.auth == null;
    }

    // =============================
    //  Attribution Tokens (토큰 기반 Attribution 시스템)
    //  • 관리자가 토큰 생성 (QR 코드용)
    //  • 랜딩페이지와 Cloud Functions에서 읽기
    //  • Cloud Functions에서 상태 업데이트 (claimed)
    // =============================
    match /attributionTokens/{tokenId} {
      // 관리자만 토큰 생성 가능
      allow create: if isAnyAdmin();
      // 관리자, 랜딩페이지(인증 없음), Cloud Functions 읽기 허용
      allow read: if isAnyAdmin() || request.auth == null || true;
      // Cloud Functions만 상태 업데이트 가능
      allow update: if request.auth == null;
      // 삭제 불가 (이력 보존)
      allow delete: if false;
    }

    // =============================
    //  Withdrawal Requests (환전 신청)
    //  • 사무실 관리자가 환전 신청 생성
    //  • 총관리자가 승인/거부/송금 처리
    //  • Cloud Functions가 자동 처리
    // =============================
    match /provinces/{provinceId}/cities/{cityId}/withdrawalRequests/{requestId} {
      // 총관리자는 모든 환전 신청 읽기 가능
      allow read: if isHeadManager();
      // 사무실 관리자는 자신의 환전 신청만 읽기 가능
      allow read: if isOfficeAdmin(provinceId, cityId, resource.data.officeId);
      // 사무실 관리자만 환전 신청 생성 가능
      allow create: if isOfficeAdmin(provinceId, cityId, request.resource.data.officeId);
      // 총관리자만 환전 신청 승인/거부/완료 처리 가능
      allow update: if isHeadManager();
      // Cloud Functions도 업데이트 가능 (자동 거부 등)
      allow update: if request.auth == null;
      // 삭제 불가 (이력 보존)
      allow delete: if false;
    }

    // =============================
    //  Emergency Alerts (긴급 알림 - 디바이스 크래시 등)
    //  • Cloud Functions(서버)만 생성 가능
    //  • 모든 관리자가 읽기 가능, 총관리자만 업데이트 가능
    // =============================
    match /emergency_alerts/{alertId} {
      // 모든 관리자가 읽기 가능 (임시 - 나중에 HEAD_MANAGER로 제한 가능)
      allow read: if isAnyAdmin();
      // Cloud Functions(서버)만 생성 가능
      allow create: if request.auth == null;
      // 총관리자가 확인/해결 처리 가능
      allow update: if isHeadManager();
      // 삭제 불가 (감사 로그 보존)
      allow delete: if false;
    }

    // =============================
    //  사무실 신청 (office_applications)
    //  • Cloud Functions(서버)가 생성
    //  • 총관리자만 읽기/수정 가능
    // =============================
    match /office_applications/{appId} {
      allow read: if isHeadManager();
      allow update: if isHeadManager();
      // Cloud Functions(서버)만 생성 가능
      allow create: if request.auth == null;
      allow delete: if false;
    }

    // =============================
    //  APK 릴리즈 (apk_releases)
    //  • 총관리자: 전체 권한
    //  • 사장님(OFFICE_OWNER): 읽기만
    // =============================
    match /apk_releases/{releaseId} {
      allow read: if isHeadManager() || isOfficeOwner();
      allow write: if isHeadManager();
    }

    // =============================
    //  acceptanceEvents (Phase 6 ① B — iOS 수락률 집계)
    //  • CF admin SDK만 write, 클라이언트 read/write 불가
    // =============================
    match /acceptanceEvents/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // =============================
    //  monthlyStats (Phase 6 ① B — 월별 수락률 집계 결과)
    //  • CF admin SDK만 write, 관리자 read 허용
    // =============================
    match /monthlyStats/{yearMonth} {
      allow read: if isAnyAdmin();
      allow write: if false;
    }

    // =============================
    //  system_config (콜마당 본부 운영 설정 — 단일계좌 안내 등)
    //  • Firestore Console 수동 운영. 클라이언트는 read 만.
    //  • doc 예: system_config/deposit_account → { bankName, accountNumber, accountHolder, contactPhone? }
    // =============================
    match /system_config/{docId} {
      allow read: if isAnyAdmin();
      allow write: if false;
    }
  }
}